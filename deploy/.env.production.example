# BiasharaMax — production environment (Hostinger shared hosting)
#
# Copy to backend/.env ON THE SERVER and fill in the blanks. Do not commit
# the filled-in copy: everything blank below is a secret, and a secret in
# git is a secret forever, even after you delete it.
#
# Every value that is left empty here is one I could not know. Guessing
# them would have produced a file that looks finished and fails at run
# time, which is harder to debug than a file that is obviously incomplete.

APP_NAME="BiasharaMax"
APP_ENV=production

# Generate on the server with: php artisan key:generate
# Leave blank here. If this is ever regenerated, every existing session
# and every encrypted column becomes unreadable.
APP_KEY=

# false in production, always. With debug on, a stack trace on any error
# shows database credentials and file paths to whoever triggered it.
APP_DEBUG=false

APP_URL=https://biasharamax.com
APP_TIMEZONE=Africa/Dar_es_Salaam
APP_LOCALE=en

# ---------------------------------------------------------------------
# Database — create this in hPanel, then paste the values it gives you.
# ---------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# ---------------------------------------------------------------------
# Queue, cache and sessions
#
# The app was written against Redis, which shared hosting does not
# provide. All three fall back to the database — the cache, jobs and
# sessions tables already have migrations, so this needs no code change.
#
# What it costs: cache reads become database queries. That is fine at this
# scale and worth revisiting on a VPS, not a reason to delay launching.
# ---------------------------------------------------------------------
QUEUE_CONNECTION=database
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Leading dot so the session is shared with any subdomain. Wrong value
# here logs people out on every navigation, which reads as a broken login.
SESSION_DOMAIN=.biasharamax.com
SESSION_SECURE_COOKIE=true

FILESYSTEM_DISK=local

# ---------------------------------------------------------------------
# Mail — Hostinger SMTP
#
# MAIL_PASSWORD stays blank in this file. Type it on the server yourself;
# it should not pass through a chat window, a repository, or me.
# ---------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=info@biasharamax.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@biasharamax.com"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------
# Public contact details (config/contact.php)
# ---------------------------------------------------------------------
CONTACT_WHATSAPP=255772800257
CONTACT_EMAIL=info@biasharamax.com
CONTACT_PHONE="+255 772 800 257"
# Left blank on purpose — the landing page hides a contact card it has no
# value for, rather than showing an empty row.
CONTACT_ADDRESS=
CONTACT_HOURS=

# ---------------------------------------------------------------------
# Desktop till downloads. Blank until you publish a build; the download
# section renders as "coming soon" rather than three dead buttons.
# ---------------------------------------------------------------------
DESKTOP_APP_VERSION=
DESKTOP_APP_URL_WINDOWS=
DESKTOP_APP_URL_MACOS=
DESKTOP_APP_URL_LINUX=

# ---------------------------------------------------------------------
# Platform alerts. Comma-separated; without it, alerts are raised and
# nobody is told.
# ---------------------------------------------------------------------
PLATFORM_ALERT_RECIPIENTS=

# Super admin seeded by PlatformUserSeeder on first run.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

LOG_CHANNEL=daily
LOG_LEVEL=warning
