# Repo-wide. backend/ and desktop-app/ each keep their own .gitignore for
# their internal build artifacts (composer/npm vendor dirs, Flutter build/,
# generated native runner folders, etc.) — see those files.

.DS_Store
Thumbs.db
*.log
/.idea
/.vscode
/.fleet
/.nova
/.zed

# Local DB backups and issued licence records — never committed.
/backups/*
!/backups/.gitkeep
/licences/*
!/licences/.gitkeep

# Docker local overrides / volumes
/docker/.env
/docker/volumes/
