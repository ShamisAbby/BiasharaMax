APP_NAME=BiasharaMax
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

BIASHARA_PLATFORM_NAME=BiasharaOS
BIASHARA_TRIAL_DAYS=30

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Target engine is MySQL 8 per docs/ADR/0001-consolidation.md. If your
# local .env still runs PostgreSQL (DB_CONNECTION=pgsql, DB_PORT=5432) from
# before that decision, that's expected until you provision MySQL and
# migrate — see the ADR before changing this on a database with real data.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=biasharaos
DB_USERNAME=biasharaos
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=biasharaos_cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local default: emails are written to storage/logs/laravel.log instead of
# being delivered. Switch to a real provider by setting MAIL_MAILER=smtp and
# filling in MAIL_HOST/PORT/USERNAME/PASSWORD. Use MAIL_SCHEME=smtps for
# implicit-TLS ports (465) or MAIL_SCHEME=smtp for STARTTLS ports (587) —
# config/mail.php has no separate "encryption" key, only "scheme".
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Platform operator alerts (security, failed backups, expiring licences).
# Comma-separated. Leave empty to disable alert email without removing the
# wiring — alerts are still recorded as seen, so enabling it later does not
# deliver a backlog.
PLATFORM_ALERT_RECIPIENTS=shamisaziz52@gmail.com
